{
    "name": "raxos/datetime",
    "description": "Datetime primitives and utilities for Raxos.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\DateTime\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "cakephp/chronos": "^3.3",
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "raxos/foundation": "^3.2"
    },
    "require-dev": {
        "raxos/database": "^3.2",
        "raxos/http": "^3.2",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "raxos/database": "to use the built-in casters.",
        "raxos/http": "to use the built-in constraints."
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.3.x-dev"
        }
    }
}
